# =============================================================================
# AI Help Desk — variáveis de ambiente (arquivo de EXEMPLO)
# =============================================================================
# 1. Copie para a raiz do repositório:   cp .env.example .env
#    (PowerShell: Copy-Item .env.example .env)
# 2. Preencha os segredos vazios (JWT_SECRET, MYSQL_ROOT_PASSWORD, MYSQL_PASSWORD).
#
# O .env real NUNCA deve ser versionado (já está no .gitignore).
# Este arquivo contém apenas placeholders seguros: nunca coloque segredos reais aqui.
#
# Gere cada segredo com um valor forte e diferente:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Formato: VARIAVEL=valor, sem espaços ao redor do "=" e sem comentários na mesma linha.

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------

# Ambiente de execução: development | test | production
ENVIRONMENT=development

# URL de conexão do SQLAlchemy.
# - Docker Compose: este valor é IGNORADO. O docker-compose.yml monta a URL do
#   serviço "mysql" a partir das variáveis MYSQL_* abaixo.
# - Dev local sem MySQL: SQLite em arquivo, criado na pasta backend/.
# - Dev local com MySQL próprio (exemplo):
#   mysql+pymysql://helpdesk:SUA_SENHA@localhost:3306/helpdesk?charset=utf8mb4
DATABASE_URL=sqlite:///./helpdesk_dev.db

# Segredo usado para assinar os tokens JWT (autenticação, etapa 04).
# - Docker Compose: obrigatório; o compose não sobe com este valor vazio.
# - Dev local sem Docker: se vazio, o backend usa um valor inseguro próprio
#   para desenvolvimento. Em ENVIRONMENT=production, exige 32+ caracteres.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Origens permitidas pelo CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# Nível de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Pasta onde os anexos enviados são gravados.
# - Vazio: usa o padrão do backend (pasta backend/uploads/, ignorada pelo Git).
# - Docker Compose: ignorado; o compose usa /app/uploads em um volume nomeado.
UPLOAD_DIR=

# Tamanho máximo de cada upload, em megabytes.
MAX_UPLOAD_SIZE_MB=10

# -----------------------------------------------------------------------------
# Inteligência Artificial e RAG (etapas 12 a 16)
# -----------------------------------------------------------------------------

# Provedor de LLM. Mantenha "none" até a etapa 12 (AI Service): o provedor
# concreto ainda será definido e, até lá, nenhuma chamada de IA é feita.
AI_PROVIDER=none

# Chave de API do provedor de IA. Segredo exclusivo do backend:
# nunca a exponha ao frontend nem use o prefixo VITE_.
AI_API_KEY=

# Identificador do modelo do provedor (definido na etapa 12).
AI_MODEL=

# URL do banco vetorial (ChromaDB).
# - Docker Compose: ignorado; o compose usa http://vector-db:8000.
# - Dev local apontando para o container do compose: http://localhost:8001
VECTOR_DB_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# MySQL (serviço "mysql" do docker-compose.yml)
# -----------------------------------------------------------------------------

# Senhas obrigatórias no Docker Compose (o compose falha se estiverem vazias).
# Use apenas letras, números, "-" e "_": a senha do usuário é inserida na
# DATABASE_URL. O comando de geração indicado acima já produz esse formato.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Nome do banco e do usuário da aplicação (o usuário não pode ser "root").
# Porta do MySQL do Docker no host (3306 geralmente está ocupada pelo XAMPP).
MYSQL_HOST_PORT=3307

MYSQL_DATABASE=helpdesk
MYSQL_USER=helpdesk

# -----------------------------------------------------------------------------
# Frontend (Vite) — somente valores NÃO sensíveis
# -----------------------------------------------------------------------------
# Variáveis VITE_* são embutidas no bundle e ficam visíveis no navegador.
# Nunca coloque segredos aqui.

# Base da API usada pelo frontend. Com o proxy do Vite, "/api/v1" evita CORS.
VITE_API_URL=/api/v1

# Destino do proxy /api do servidor de desenvolvimento do Vite.
# - Docker Compose: ignorado; o compose usa http://backend:8000.
VITE_PROXY_TARGET=http://localhost:8000

# Intervalo (segundos) do monitor de SLA embutido na API; 0 desliga.
SLA_MONITOR_INTERVAL_SECONDS=300
